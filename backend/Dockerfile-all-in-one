FROM python:3.12-slim

WORKDIR /app

# Install system dependencies, PostgreSQL, and Redis
RUN apt-get update && apt-get install -y \
    gcc \
    libpq-dev \
    curl \
    postgresql \
    postgresql-contrib \
    redis-server \
    supervisor \
    && rm -rf /var/lib/apt/lists/*

# Copy and install python requirements
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# Copy a supervisor configuration to manage multiple processes
# (Or use a custom entrypoint script)
COPY supervisord.conf /etc/supervisor/conf.d/supervisord.conf

EXPOSE 8000

# Start via supervisor which runs Postgres, Redis, and Uvicorn concurrently
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]